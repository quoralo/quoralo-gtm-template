___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Quoralo AI Chat Agent - loads the Quoralo chat widget for one agent.
const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const log = require('logToConsole');

const BASE_URL = 'https://www.quoralo.com/api/widget/';
const LOG_PREFIX = '[Quoralo / GTM] ';
const ALLOWED = 'abcdefghijklmnopqrstuvwxyz0123456789-';

// Accepts the identifier itself (my-agent) or the chat link (https://www.quoralo.com/c/my-agent).
const readAgentId = (value) => {
  let id = value ? value.trim().toLowerCase() : '';
  const markers = ['/api/widget/', '/c/'];
  for (let i = 0; i < markers.length; i++) {
    const pos = id.indexOf(markers[i]);
    if (pos >= 0) {
      id = id.substring(pos + markers[i].length);
    }
  }
  const stops = ['?', '#', '/'];
  for (let j = 0; j < stops.length; j++) {
    const cut = id.indexOf(stops[j]);
    if (cut >= 0) {
      id = id.substring(0, cut);
    }
  }
  if (id.length < 1 || id.length > 80) {
    return '';
  }
  for (let k = 0; k < id.length; k++) {
    if (ALLOWED.indexOf(id.charAt(k)) < 0) {
      return '';
    }
  }
  return id;
};

const agentId = readAgentId(data.agentId);

if (agentId === '') {
  log(LOG_PREFIX + 'Invalid agent identifier: ' + data.agentId);
  data.gtmOnFailure();
} else {
  const url = BASE_URL + encodeUriComponent(agentId);
  const onFailure = () => {
    log(LOG_PREFIX + 'Could not load ' + url);
    data.gtmOnFailure();
  };
  // The URL is the cache token: the widget is loaded only once per page, even if the tag fires twice.
  injectScript(url, data.gtmOnSuccess, onFailure, url);
}


