___TESTS___

scenarios:
- name: Loads the widget for an agent identifier
  code: |-
    runCode({agentId: 'my-agent'});
    assertThat(injectedUrl).isEqualTo('https://www.quoralo.com/api/widget/my-agent');
    assertThat(cacheToken).isEqualTo('https://www.quoralo.com/api/widget/my-agent');
    assertApi('gtmOnSuccess').wasCalled();
- name: Accepts the chat link and upper case letters
  code: |-
    runCode({agentId: ' https://www.quoralo.com/c/My-Agent?utm=x '});
    assertThat(injectedUrl).isEqualTo('https://www.quoralo.com/api/widget/my-agent');
    assertApi('gtmOnSuccess').wasCalled();
- name: Rejects an invalid identifier
  code: |-
    runCode({agentId: 'my agent!'});
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Fails when the widget cannot load
  code: |-
    mock('injectScript', (url, onSuccess, onFailure, token) => {
      onFailure();
    });
    runCode({agentId: 'my-agent'});
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  let injectedUrl;
  let cacheToken;
  mock('injectScript', (url, onSuccess, onFailure, token) => {
    injectedUrl = url;
    cacheToken = token;
    onSuccess();
  });


